# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Which database this shop runs on: `postgresql` (the `standard` choice in
# ShopHub) or `redis` (`light`). The operator passes the Shop resource's
# `spec.database` through as this, and only the matching block below is read.
DB_KIND=postgresql

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shop
DB_PASSWORD=shop
DB_NAME=shop
DB_SYNCHRONIZE=true

# Auth (JWT_SECRET is required, the app refuses to start without it)
JWT_SECRET=change-me-in-every-deployment
JWT_EXPIRES_IN=1h

# Shop admin, created on startup when both values are set
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=admin1234
SHOP_ADMIN_DISPLAY_NAME=Shop Admin

# Redis, when DB_KIND=redis. REDIS_PASSWORD may be left empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
