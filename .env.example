# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Which database this shop runs on: `postgresql` (the `standard` choice in
# ShopHub) or `redis` (`light`). The operator passes the Shop resource's
# `spec.database` through as this, and only the matching block below is read.
DB_KIND=postgresql

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shop
DB_PASSWORD=shop
DB_NAME=shop
DB_SYNCHRONIZE=true

# Auth (JWT_SECRET is required, the app refuses to start without it)
JWT_SECRET=change-me-in-every-deployment
JWT_EXPIRES_IN=1h

# Shop admin, created on startup when both values are set
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=admin1234
SHOP_ADMIN_DISPLAY_NAME=Shop Admin

# Payments.
#
# WALLET_ADDRESS is where customers pay this shop; the operator passes the Shop
# resource's `spec.walletAddress` through as this. Unset means the shop still
# sells but its orders cannot be paid, and it says so in the log at startup.
#
# RPC_URL is how the *backend* verifies a payment. In the cluster it is a
# Service name (http://anvil:8545); the browser never sees it — the customer's
# wallet holds its own connection to the chain.
#
# PAYMENT_CONFIRMATIONS is 0 for Anvil, which mines a block per transaction and
# then stops. Raise it to 1 or 2 on a public testnet, where a reorg can un-mine
# a block.
WALLET_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
PAYMENT_CONFIRMATIONS=0

# Redis, when DB_KIND=redis. REDIS_PASSWORD may be left empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
